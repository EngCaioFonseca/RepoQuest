# Optional server-only GitHub token. Never prefix this with NEXT_PUBLIC_.
# Leave empty for the credential-free demo.
GITHUB_TOKEN=

# SQLite file; its parent directory must be writable.
# Docker Compose overrides this with /app/data/repoquest.db.
# Use :memory: to look at your progress once without saving anything.
DATABASE_PATH=./data/repoquest.db

# Optional cloud save, so a fresh install restores your progress instead of
# re-importing history. gist: a secret Gist owned by the GITHUB_TOKEN user
# (the token needs Gists read and write permission). postgres: your own
# database in CLOUD_DATABASE_URL, for example a free Neon project. Default off.
CLOUD_SAVE=
# Server-only; never prefix with NEXT_PUBLIC_.
CLOUD_DATABASE_URL=
